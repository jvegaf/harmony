{
  "name": "harmony",
  "version": "1.6.2",
  "description": "Music manager for old-school DJs",
  "main": "./out/main/index.js",
  "author": "Jose Vega",
  "license": "MIT",
  "homepage": "https://github.com/jvegaf/Harmony#readme",
  "repository": "https://github.com/jvegaf/Harmony",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "pnpm run build && electron-builder --win --config",
    "build:linux": "pnpm run build && electron-builder --linux --config",
    "release": "electron-builder",
    "db:push": "drizzle-kit push",
    "db:check-dupes": "node scripts/check-duplicates.js",
    "db:clean-dupes": "node scripts/cleanup-duplicates.js"
  },
  "dependencies": {
    "@alexjorgef/bandcamp-scraper": "^1.4.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@tabler/icons-react": "^3.46.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "async-g-i-s": "^1.5.5",
    "axios": "^1.19.0",
    "bandcamp-fetch": "^3.2.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cloudscraper": "^4.6.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "electron-store": "11.0.2",
    "essentia.js": "^0.1.3",
    "fast-xml-parser": "^5.11.0",
    "googlethis": "^1.8.0",
    "html-minifier-terser": "^7.2.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "music-metadata": "^11.15.0",
    "node-id3": "^0.2.9",
    "node-wav": "^0.0.2",
    "p-limit": "^7.3.1",
    "react-icons": "^5.7.0",
    "react-keybinding-component": "^2.3.1",
    "recursive-readdir": "^2.2.3",
    "soundcloud.ts": "^0.7.4",
    "styled-components": "^6.5.3",
    "uuid": "^14.0.2",
    "wavesurfer.js": "^7.12.11",
    "xmlbuilder2": "^4.0.3",
    "youtube-music-api": "^1.0.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cheerio": "^1.0.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/recursive-readdir": "^2.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "classnames": "^2.5.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globby": "^16.2.4",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "queue": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
